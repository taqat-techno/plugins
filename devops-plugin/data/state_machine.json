        "ProductBacklogItem": {
          "name": "Product Backlog Item",
          "referenceName": "Scrum.ProductBacklogItem",
          "states": [
            "New",
            "Approved",
            "Committed",
            "In Progress",
            "Ready For QC",
            "Return",
            "Done",
            "Removed"
          ],
          "happyPath": [
            "New",
            "Approved",
            "Committed",
            "In Progress",
            "Ready For QC",
            "Done"
