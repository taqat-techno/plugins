            "In Progress"
          ],
          "hasClose": false,
          "hasReturn": true,
          "hasRemoved": true,
          "qcGate": {
            "rule": "Must go through 'Ready For QC' before 'Done'",
            "blockedTransitions": [
              "In Progress -> Done",
              "New -> Done",
              "Approved -> Done",
              "Committed -> Done"
