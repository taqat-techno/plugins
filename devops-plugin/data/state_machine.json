    "custom-scrum-qc": {
      "displayName": "Customized Scrum with QC gates (opt-in)",
      "source": "custom",
      "basedOn": "scrum",
      "note": "An opt-in preset for organizations running a CUSTOMIZED Scrum process: PBIs and Bugs move through 'In Progress' (and 'Ready For QC'), an Enhancement type, QC Return loops, fixed Task-title prefixes, and role rules (QA-only Bug creation, PM/Lead-only Close/Remove). It is NOT stock Scrum. Select it with 'process: custom-scrum-qc' in the profile; /init proposes it only when the live project has the Enhancement type or a 'Ready For QC' PBI state.",
      "transitionModel": "explicit",
      "requirementType": "Product Backlog Item",
      "workItemTypes": {
        "Task": {
          "name": "Task",
          "referenceName": "Scrum.Task",
          "states": [
            "To Do",
            "In Progress",
            "Done",
            "Closed",
            "Removed"
          ],
          "happyPath": [
            "To Do",
            "In Progress",
            "Done",
            "Closed"
          ],
          "hasClose": true,
          "hasReturn": false,
          "hasRemoved": true,
          "transitions": {
            "To Do -> In Progress": {
              "requiredFields": [],
              "autoSetFields": {}
            },
            "In Progress -> Done": {
              "requiredFields": [
                {
                  "field": "Microsoft.VSTS.Scheduling.OriginalEstimate",
                  "path": "/fields/Microsoft.VSTS.Scheduling.OriginalEstimate",
                  "prompt": "Original Estimate (hours): How many hours did you estimate for this task?",
                  "type": "number",
                  "min": 0
                },
                {
                  "field": "Microsoft.VSTS.Scheduling.CompletedWork",
                  "path": "/fields/Microsoft.VSTS.Scheduling.CompletedWork",
                  "prompt": "Completed Work (hours): How many hours did you actually spend?",
                  "type": "number",
                  "min": 0
                }
              ],
              "autoSetFields": {
                "Microsoft.VSTS.Scheduling.RemainingWork": "0"
              }
            },
            "To Do -> Done": {
              "requiredFields": [
                {
                  "field": "Microsoft.VSTS.Scheduling.OriginalEstimate",
                  "path": "/fields/Microsoft.VSTS.Scheduling.OriginalEstimate",
                  "prompt": "Original Estimate (hours): How many hours did you estimate for this task?",
                  "type": "number",
                  "min": 0
                },
                {
                  "field": "Microsoft.VSTS.Scheduling.CompletedWork",
                  "path": "/fields/Microsoft.VSTS.Scheduling.CompletedWork",
                  "prompt": "Completed Work (hours): How many hours did you actually spend?",
                  "type": "number",
                  "min": 0
                }
              ],
              "autoSetFields": {
                "Microsoft.VSTS.Scheduling.RemainingWork": "0"
              }
            },
            "Done -> Closed": {
              "requiredFields": [],
              "autoSetFields": {}
            },
            "Any -> Removed": {
              "requiredFields": [],
              "autoSetFields": {}
            }
          }
        },
        "Bug": {
          "name": "Bug",
          "referenceName": "Scrum.Bug",
          "states": [
            "New",
            "Approved",
            "In Progress",
            "Resolved",
            "Return",
            "Committed",
            "Done",
            "Closed",
            "Removed"
          ],
          "happyPath": [
            "New",
            "Approved",
            "In Progress",
            "Resolved",
            "Done",
            "Closed"
          ],
          "returnPath": [
            "Resolved",
            "Return",
            "In Progress"
          ],
          "hasClose": true,
          "hasReturn": true,
          "hasRemoved": true,
          "transitions": {
            "New -> Approved": {
              "requiredFields": [],
              "autoSetFields": {}
            },
            "Approved -> In Progress": {
              "requiredFields": [],
              "autoSetFields": {}
            },
            "In Progress -> Resolved": {
              "requiredFields": [
                {
                  "field": "Microsoft.VSTS.Common.ResolvedReason",
                  "path": "/fields/Microsoft.VSTS.Common.ResolvedReason",
                  "prompt": "Resolved Reason: Why is this bug being resolved?",
                  "type": "select",
                  "options": [
                    "Fixed",
                    "As Designed",
                    "Cannot Reproduce",
                    "Deferred",
                    "Duplicate",
                    "Not a Bug",
                    "Obsolete"
                  ],
                  "default": "Fixed"
                },
                {
                  "field": "Microsoft.VSTS.Scheduling.CompletedWork",
                  "path": "/fields/Microsoft.VSTS.Scheduling.CompletedWork",
                  "prompt": "Completed Work (hours): How many hours did you spend fixing this bug?",
                  "type": "number",
                  "min": 0
                }
              ],
              "autoSetFields": {}
            },
            "Resolved -> Return": {
              "requiredFields": [],
              "requiresComment": true,
              "commentPrompt": "Return reason: Please describe why this fix is being rejected.",
              "autoSetFields": {}
            },
            "Return -> In Progress": {
              "requiredFields": [],
              "autoSetFields": {}
            },
            "In Progress -> Committed": {
              "requiredFields": [],
              "autoSetFields": {}
            },
            "Committed -> In Progress": {
              "requiredFields": [],
              "autoSetFields": {}
            },
            "Committed -> Done": {
              "requiredFields": [],
              "autoSetFields": {}
            },
            "Resolved -> Done": {
              "requiredFields": [],
              "autoSetFields": {}
            },
            "Done -> Closed": {
              "requiredFields": [],
              "autoSetFields": {}
            },
            "Any -> Removed": {
              "requiredFields": [],
              "autoSetFields": {}
            }
          }
