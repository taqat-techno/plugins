{
  "_meta": {
    "description": "Single source of truth for work item processes (states, transitions, optional role and naming rules), required fields, and API error patterns. Process models are named presets under processPresets; the active one is the profile's 'process' field (${CLAUDE_PLUGIN_DATA}/profile.md, legacy ~/.claude/devops.md), set by /init's process-detection step.",
    "version": "7.0.0",
    "lastUpdated": "2026-10-19",
    "processModelNote": "Four presets (basic, agile, scrum, cmmi) encode Microsoft's stock templates and carry NO role or naming rules. 'custom-scrum-qc' is an opt-in customized-Scrum preset with role rules and Task prefixes. Role/naming rules apply only when the active preset or the profile defines them; violations ask for confirmation by default."
  },
  "defaultPreset": "agile",
  "presetDetection": {
    "$comment": "Used by commands/init.md 'Detect the process'. Evaluate top to bottom against the work item type names the project exposes (wit_list_backlogs + wit_get_work_item_type); first match wins.",
    "order": [
      {
        "preset": "custom-scrum-qc",
        "when": "type 'Product Backlog Item' exists AND (type 'Enhancement' exists OR the PBI states include 'Ready For QC')"
      },
      {
        "preset": "scrum",
        "when": "type 'Product Backlog Item' exists"
      },
      {
        "preset": "agile",
        "when": "type 'User Story' exists"
      },
      {
        "preset": "cmmi",
        "when": "type 'Requirement' exists"
      },
      {
        "preset": "basic",
        "when": "type 'Issue' exists and Task states are To Do / Doing / Done"
      }
    ],
    "fallback": "Ask the user which process the project uses (Project Settings > Overview shows it); if still unknown use defaultPreset."
  },
