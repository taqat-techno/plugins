              "turn"
            ],
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "failure"
            ],
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "failure"
            ],
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "failure"
            ],
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
