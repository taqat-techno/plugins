{
  "description": "notification plugin hooks. Seven events, each registered three times - `python3`, `python`, `py -3` - all routed to hooks/notify.py. Exec form (command + args) has no shell to fall back between interpreter names (D-003), and no single name exists on every host: macOS and Debian/Ubuntu ship only python3, python.org Windows installs ship python and py, and python3 on Windows is often the Microsoft Store alias. A name that is missing never starts; the first process that does start claims the event under ${CLAUDE_PLUGIN_DATA}/state and the others exit (D-016). `async: true` is load-bearing: PreToolUse, PostToolUse, UserPromptSubmit, Stop and TaskCompleted are blocking events where exit 2 would suppress a question, feed an error back to Claude, erase the user's prompt, trap a turn or refuse a task completion; an async hook cannot block or control Claude at all. The script never writes to stdout, never exits non-zero, never runs a shell, and never writes under the plugin root. Run /notification:doctor to see which interpreter handled the last event.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "question"
            ],
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "question"
            ],
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "question"
            ],
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "answered"
            ],
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "answered"
            ],
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "answered"
            ],
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "prompted"
            ],
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "prompted"
            ],
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "prompted"
            ],
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "permission"
            ],
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "permission"
            ],
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "permission"
            ],
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "task"
            ],
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "task"
            ],
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "task"
            ],
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "turn"
            ],
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify.py",
              "turn"
            ],
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
