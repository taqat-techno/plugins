# Normalize line endings so edits made on Windows do not produce whole-file
# diffs against a repository authored with LF. Without this, a single-line edit
# from a Windows editor rewrites every line of the file and the review becomes
# unreadable (measured: 385 of 506 changed files were pure CRLF churn).
* text=auto eol=lf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary

# Windows-native scripts keep CRLF; some Windows hosts require it.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
