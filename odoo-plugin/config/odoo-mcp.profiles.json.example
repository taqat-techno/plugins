{
  "//": [
    "The Odoo MCP connection file: ~/.odoo-mcp/profiles.json (one per Windows account).",
    "Change it with python <odoo-plugin>/scripts/mcp/odoo_mcp.py (add / bind / local / remove);",
    "it validates, backs up and logs every change. Keys may be written here directly.",
    "",
    "A session belongs to the project whose \"paths\" contain its folder (git worktrees count as",
    "their main checkout). Tools take an optional instance (\"prod\", or \"project/instance\");",
    "without it they use the project's \"default\".",
    "",
    "For Odoo.sh staging, create the MCP user and key in PRODUCTION - every staging build",
    "copies production, so the key survives rebuilds - and use \"db\": \"auto\".",
    "Use a DEDICATED least-privilege Odoo user for remote instances."
  ],
  "version": 2,
  "projects": {
    "acme": {
      "paths": ["C:/work/acme"],
      "default": "stage",
      "instances": {
        "local": {
          "url": "http://127.0.0.1:8069",
          "db": "acme_dev",
          "username": "admin",
          "api_key": "<local key - odoo_mcp.py local creates one>"
        },
        "stage": {
          "url": "https://acme-stage.odoo.com",
          "db": "auto",
          "username": "mcp_agent",
          "api_key": "<staging key>",
          "tier": "stage",
          "access": "write"
        },
        "prod": {
          "url": "https://erp.acme.example.com",
          "db": "acme",
          "username": "mcp_readonly",
          "api_key": "<production key>",
          "tier": "prod",
          "access": "read",
          "timeout": 60
        }
      }
    }
  },
  "//options": {
    "paths": "Project: the folders it covers (sub-folders and git worktrees match too). A folder belongs to one project.",
    "default": "Project: the instance used when a call names none. Omitted: the single local instance, else the single stage instance. A prod instance is the default only when written here.",
    "url": "Required. tier local is accepted only for a loopback url (localhost, *.localhost, 127.x.x.x, ::1).",
    "db": "Database. \"auto\" (local/stage only): the one database the url serves, re-checked after a rebuild, kept in memory only. prod needs an explicit db and is never followed.",
    "db_pattern": "Optional regex that picks the database when an \"auto\" url serves several, e.g. \"^acme-stage-\\\\d+$\".",
    "username": "Odoo login. Required for Odoo <=18 (XML-RPC).",
    "api_key": "API key (or a local password). \"${ENV_VAR}\" also works; an unset variable is reported, never sent empty.",
    "tier": "local | stage | prod. Required for any remote url - never guessed.",
    "access": "The limit: read | write | full (write + delete). Default: local full, stage write, prod read. A prod instance also needs odoo_session unlock to write.",
    "allow_write_models": "Escape hatch: models exempt from the privilege-escalation write blocklist (res.users, ir.actions.server, ir.cron, ir.config_parameter, ...). Leave empty unless certain.",
    "companies": "allowed_company_ids for every call. Important on multi-company databases.",
    "lang": "Context language, e.g. 'fr_FR'.",
    "tz": "Context timezone, e.g. 'Europe/Paris'.",
    "timeout": "Per-request timeout in seconds. Default 30, range 5-600.",
    "verify_ssl": "Default true. false is refused on prod."
  }
}
