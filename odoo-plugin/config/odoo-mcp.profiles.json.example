{
  "//": [
    "Developer-owned connection profiles for the bundled Odoo MCP server.",
    "Save as ~/.odoo-mcp/servers.json (one file for all your projects), or pin one checkout",
    "with <project>/.odoo-mcp.json (keep that out of version control).",
    "",
    "LOCAL instances do not belong here: Claude creates them itself with",
    "  python <odoo-plugin>/scripts/mcp/local_profile.py provision",
    "into ~/.odoo-mcp/local/, one file per checkout, with expiring keys.",
    "",
    "Keys: write \"${ENV_VAR}\" and export the variable. For Odoo.sh staging, create the",
    "MCP user and key in PRODUCTION - every staging build copies production, so the key",
    "survives rebuilds; a staging-made key dies with the build. The staging database",
    "name itself is followed automatically after a rebuild.",
    "",
    "Use a DEDICATED least-privilege Odoo user for remote instances - the server acts as",
    "that user and inherits exactly its access rights and record rules."
  ],
  "profiles": {
    "acme-stage": {
      "url": "https://acme-stage.example.com",
      "username": "mcp_agent",
      "api_key": "${ACME_STAGE_KEY}",
      "tier": "staging",
      "ceiling": "write",
      "projects": [
        "~/work/acme"
      ]
    },
    "acme-prod": {
      "url": "https://erp.acme.example.com",
      "db": "acme",
      "username": "mcp_readonly",
      "api_key": "${ACME_PROD_KEY}",
      "tier": "production",
      "ceiling": "read",
      "projects": [
        "~/work/acme"
      ],
      "timeout": 60
    },
    "shared-dev-box": {
      "url": "http://dev-box.test:8069",
      "db": "team_dev",
      "username": "mcp_agent",
      "api_key": "${DEV_BOX_KEY}",
      "tier": "local",
      "projects": [
        "~/work/acme",
        "~/work/other"
      ]
    }
  },
  "//options": {
    "url": "Base URL. Required. tier local is accepted only for loopback hosts (localhost, 127.x, ::1, *.localhost, *.test).",
    "db": "Database. Optional on Odoo 19+ (the host selects it). Followed automatically when a staging rebuild renames it; the new name is recorded in ~/.odoo-mcp/state/learned.json, never here.",
    "db_pattern": "Optional regex that picks the right database when a rebuilt server lists several, e.g. \"^acme-stage-\\\\d+$\".",
    "username": "Odoo login. Required for Odoo <=18 (XML-RPC).",
    "api_key": "API key. Supports ${ENV_VAR}.",
    "tier": "local | staging | production. Default: local for a loopback url, else staging; legacy \"production\": true means production.",
    "ceiling": "The MOST any session may do: read | write | write+unlink. Claude can move below it with approval, never above. Default: local write+unlink, staging write, production read.",
    "start": "The mode a session starts in. Default: local write, otherwise read.",
    "approval": "What raising the mode needs: none | chat (the developer's verbatim yes) | human (odoo_mcp_ctl.py approve, run in the developer's terminal). Default: local none, staging chat, production human. Production may be chat, never none.",
    "projects": "Checkouts this profile serves. A remote profile is only used when bound here or chosen with odoo_session - never as a global default.",
    "allow_write_models": "Escape hatch: models exempt from the privilege-escalation write blocklist (res.users, ir.actions.server, ir.cron, ir.config_parameter, ...). Leave empty unless certain.",
    "allowed_company_ids": "allowed_company_ids in the Odoo context for every call. Important on multi-company databases.",
    "lang": "Context language, e.g. 'fr_FR'.",
    "tz": "Context timezone, e.g. 'Europe/Paris'.",
    "timeout": "Per-request timeout in seconds. Default 30, max 600.",
    "verify_ssl": "Default true. false is refused on production profiles.",
    "legacy": "mode / production / allow_unlink / allow_production_writes / project_map still load and map onto start / tier / ceiling / projects."
  }
}
