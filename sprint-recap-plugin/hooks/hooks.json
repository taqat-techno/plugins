{
  "description": "sprint-recap hooks - SessionStart credential-hygiene check (advisory) + PreToolUse gate that blocks git from staging the plaintext credential artifacts this plugin generates. Only the commit gate BLOCKS.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start_config_check.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_commit_secret_gate.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
