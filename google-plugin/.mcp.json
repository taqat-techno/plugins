{
  "google": {
    "type": "stdio",
    "command": "node",
    "args": [
      "${CLAUDE_PLUGIN_ROOT}/server/index.mjs"
    ],
    "env": {
      "GOOGLE_PLUGIN_CLIENT_SECRET_FILE": "${user_config.google_client_secret_file}",
      "GOOGLE_PLUGIN_CLIENT_ID": "${user_config.google_client_id}",
      "GOOGLE_PLUGIN_MODULES": "${user_config.google_modules}",
      "GOOGLE_PLUGIN_READONLY": "${user_config.google_read_only}",
      "GOOGLE_CLIENT_SECRET_FILE": "${GOOGLE_CLIENT_SECRET_FILE:-}",
      "GOOGLE_MODULES": "${GOOGLE_MODULES:-}",
      "GOOGLE_READONLY": "${GOOGLE_READONLY:-}",
      "GOOGLE_PLUGIN_HOME": "${GOOGLE_PLUGIN_HOME:-}",
      "GOOGLE_TIMEOUT_MS": "${GOOGLE_TIMEOUT_MS:-}",
      "GOOGLE_TOOLS_ALLOW": "${GOOGLE_TOOLS_ALLOW:-}",
      "GOOGLE_TOOLS_DENY": "${GOOGLE_TOOLS_DENY:-}",
      "GOOGLE_CONFIRM_MODE": "${GOOGLE_CONFIRM_MODE:-}",
      "GOOGLE_CONFIRM_TIMEOUT_MS": "${GOOGLE_CONFIRM_TIMEOUT_MS:-}",
      "GOOGLE_MAX_STRING_CHARS": "${GOOGLE_MAX_STRING_CHARS:-}",
      "GOOGLE_MAX_RESULT_CHARS": "${GOOGLE_MAX_RESULT_CHARS:-}",
      "GOOGLE_PLUGIN_IDENTITIES_FILE": "${user_config.google_identities_file}",
      "GOOGLE_IDENTITIES_FILE": "${GOOGLE_IDENTITIES_FILE:-}",
      "GOOGLE_IDENTITIES": "${GOOGLE_IDENTITIES:-}",
      "GOOGLE_PLUGIN_DOWNLOAD_DIR": "${user_config.google_download_dir}",
      "GOOGLE_DOWNLOAD_DIR": "${GOOGLE_DOWNLOAD_DIR:-}",
      "GOOGLE_MAX_SAVE_MB": "${GOOGLE_MAX_SAVE_MB:-}",
      "GOOGLE_REFUSE_GUEST_EVENTS": "${GOOGLE_REFUSE_GUEST_EVENTS:-}",
      "GOOGLE_WRITE_LIMIT_PER_HOUR": "${GOOGLE_WRITE_LIMIT_PER_HOUR:-}",
      "GOOGLE_REST_FALLBACK": "${GOOGLE_REST_FALLBACK:-}",
      "GOOGLE_ATTACH_DIRS": "${GOOGLE_ATTACH_DIRS:-}",
      "GOOGLE_BOUNCE_CHECK_SECONDS": "${GOOGLE_BOUNCE_CHECK_SECONDS:-}",
      "GOOGLE_GMAIL_SETTINGS": "${GOOGLE_GMAIL_SETTINGS:-}",
      "GOOGLE_FULL_MAILBOX": "${GOOGLE_FULL_MAILBOX:-}",
      "GOOGLE_CLI_COMMAND": "${GOOGLE_CLI_COMMAND:-}",
      "GOOGLE_PHOTOS": "${GOOGLE_PHOTOS:-}"
    }
  }
}
